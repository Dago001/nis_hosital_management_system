# =============================================================================
# NIS Medical Services — PRODUCTION environment template
# -----------------------------------------------------------------------------
# Copy this file to `.env` on the production server and fill in the real values:
#     cp .env.production.example .env
#     php artisan key:generate          # generates a fresh APP_KEY
#     php artisan config:cache
#     php artisan migrate --force
#     php artisan storage:link
#
# NEVER commit the real `.env` (it is git-ignored). Rotate any secret that has
# ever been shared or committed.
# =============================================================================

APP_NAME="NIS Medical Services"
APP_ENV=production
# Generated with `php artisan key:generate` — leave blank here, set on the server.
APP_KEY=
# Debug MUST be false in production (true leaks stack traces and config).
APP_DEBUG=false
# The public HTTPS URL of the deployment.
APP_URL=https://hms.immigration.gov.ng

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

# Cost factor for password hashing (10-12 is a good production range).
BCRYPT_ROUNDS=12

# --- Logging -----------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
# Do not log debug in production; warning keeps noise down while capturing issues.
LOG_LEVEL=warning

# --- Database (PostgreSQL recommended for production) -------------------------
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=nis_hms
DB_USERNAME=nis_hms
DB_PASSWORD=

# --- Session (encrypted + HTTPS-only cookies) --------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
# Set to the deployment domain so the cookie is scoped correctly.
SESSION_DOMAIN=hms.immigration.gov.ng
# Only send the session cookie over HTTPS.
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# Sanctum stateful domains (SPA/blade on the same host).
SANCTUM_STATEFUL_DOMAINS=hms.immigration.gov.ng

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Mail (required for appointment reminders to actually send) ---------------
# Use a real SMTP relay. With MAIL_MAILER=log, reminders are only recorded, not sent.
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=tls
MAIL_FROM_ADDRESS="no-reply@immigration.gov.ng"
MAIL_FROM_NAME="${APP_NAME}"

# --- File storage (only needed if using S3-compatible object storage) --------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Clinical AI Advisor (optional) ------------------------------------------
# Leave ANTHROPIC_API_KEY empty to use the built-in offline knowledge base.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_MAX_TOKENS=2000

# --- Seeding -----------------------------------------------------------------
# Password used for seeded demo/staff accounts. MUST be overridden (or the demo
# accounts removed) before go-live. Leave blank in production to force a change.
SEED_PASSWORD=

VITE_APP_NAME="${APP_NAME}"
